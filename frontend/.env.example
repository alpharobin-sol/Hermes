# Hermes backend
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"

# mainnet-beta or devnet. Must match SOLANA_NETWORK on the backend.
NEXT_PUBLIC_SOLANA_NETWORK="mainnet-beta"
# Devnet RPC for balances and sending deposits. Defaults to https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=""

# Solana RPC used for balances and confirming deposits.
# api.mainnet-beta.solana.com blocks browser requests, so it will not work here.
# Defaults to https://solana-rpc.publicnode.com. Use a Helius or Triton URL in production.
NEXT_PUBLIC_SOLANA_RPC_URL=""
