# API server
PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"
# Comma-separated origins allowed to call the API. Leave empty to allow all.
CORS_ORIGIN=""

# Network deposits are built for: mainnet-beta or devnet. Yield data always comes from mainnet.
SOLANA_NETWORK="mainnet-beta"
# RPC for building devnet deposits. Defaults to https://api.devnet.solana.com
DEVNET_RPC_URL=""

# Jupiter swap API (mainnet LST deposits)
# The free lite endpoint is rate limited. Get a key at https://portal.jup.ag for production.
JUPITER_API_URL="https://lite-api.jup.ag/swap/v1"
JUPITER_API_KEY=""
# Jupiter Lend API (Jupiter Lend rates)
JUPITER_LEND_API_URL="https://lite-api.jup.ag/lend/v1"
# Reject deposit quotes above this price impact (percent)
DEPOSIT_MAX_PRICE_IMPACT_PCT=1
